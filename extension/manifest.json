{
  "manifest_version": 3,
  "name": "AdEarn AI Companion & ChatGPT Sponsored Prompts",
  "version": "1.1.0",
  "description": "Voluntary rewards companion, real-time wallet telemetry, and authorized sponsored brand prompts on ChatGPT.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "AdEarn AI Companion"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.adearn.ai/*",
    "https://chatgpt.com/*",
    "https://*.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.openai.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
