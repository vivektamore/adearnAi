# Database connection string (MySQL 8.0)
DATABASE_URL="mysql://username:password@localhost:3306/adearn_ai"

# Application Settings
NEXT_PUBLIC_APP_NAME="AdEarn AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="production"
PORT=3000

# Authentication & JWT
JWT_SECRET="generate-a-strong-random-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Redis Cache & Queue
REDIS_URL="redis://localhost:6379"

# Payout Mode: 'sandbox' or 'live'
PAYOUT_MODE="sandbox"
RAZORPAYX_KEY_ID="rzp_live_or_test_key"
RAZORPAYX_KEY_SECRET="rzp_live_or_test_secret"
RAZORPAYX_ACCOUNT_NUMBER="nodal_account_number"

# Telemetry & Anti-Fraud Security
TELEMETRY_SIGNING_KEY="production-telemetry-signing-key"
MAX_DAILY_EARNING_CAP_PAISE=500000
MIN_WITHDRAWAL_THRESHOLD_PAISE=10000
