generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADVERTISER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum KycTier {
  TIER_0
  TIER_1
  TIER_2
}

enum CampaignStatus {
  DRAFT
  IN_REVIEW
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
}

enum ActionType {
  SURVEY
  SANDBOX_TRIAL
  APP_INSTALL
  VIDEO_ATTENTION
  SENTIMENT_POLL
}

enum TaskStatus {
  STARTED
  SUBMITTED
  VALIDATED
  REJECTED
  EXPIRED
}

enum FraudVerdict {
  CLEARED
  FLAGGED
  BLOCKED
}

enum LedgerTransactionType {
  CREDIT_REWARD
  DEBIT_WITHDRAWAL
  ESCROW_LOCK
  ESCROW_RELEASE
  ADVERTISER_TOPUP
  ADMIN_ADJUSTMENT
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  CLEARED
  FAILED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_CREDITED
  REJECTED
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  passwordHash       String
  name               String
  role               Role         @default(USER)
  status             UserStatus   @default(ACTIVE)
  kycTier            KycTier      @default(TIER_1)
  kycStatus          String       @default("VERIFIED")
  upiId              String?
  bankAccountNumber  String?
  bankIfsc           String?
  bankAccountName    String?
  avatarUrl          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  wallet             Wallet?
  userOrganizations  UserOrganization[]
  userTasks          UserTask[]
  payoutRequests     PayoutRequest[]
  disputes           Dispute[]
  auditLogs          AuditLog[]   @relation("ActorAuditLogs")

  @@index([email])
  @@index([role])
}

model Organization {
  id                 String       @id @default(cuid())
  name               String
  gstin              String?
  pan                String?
  contactEmail       String
  isVerified         Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  users              UserOrganization[]
  wallet             Wallet?
  campaigns          Campaign[]

  @@index([name])
}

model UserOrganization {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String       @default("OWNER")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Wallet {
  id                  String       @id @default(cuid())
  userId              String?      @unique
  organizationId      String?      @unique
  availablePaise      BigInt       @default(0)
  pendingPaise        BigInt       @default(0)
  escrowPaise         BigInt       @default(0)
  lifetimeEarnedPaise BigInt       @default(0)
  lifetimePaidPaise   BigInt       @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user                User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization        Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions        LedgerTransaction[]

  @@index([userId])
  @@index([organizationId])
}

model LedgerTransaction {
  id                 String                 @id @default(cuid())
  referenceId        String
  walletId           String
  type               LedgerTransactionType
  amountPaise        BigInt
  balanceAfterPaise  BigInt
  idempotencyKey     String                 @unique
  reason             String
  metadata           String?                @db.Text
  createdAt          DateTime               @default(now())

  wallet             Wallet                 @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([referenceId])
  @@index([idempotencyKey])
}

model Campaign {
  id                   String         @id @default(cuid())
  organizationId       String
  title                String
  description          String         @db.Text
  category             String         @default("FinTech")
  actionType           ActionType     @default(SURVEY)
  status               CampaignStatus @default(DRAFT)
  targetUrl            String         @db.Text
  requirementsJson     String?        @db.Text
  budgetAllocatedPaise BigInt         @default(0)
  budgetSpentPaise     BigInt         @default(0)
  costPerOutcomePaise  BigInt         @default(0)
  targetOutcomes       Int            @default(100)
  verifiedOutcomes     Int            @default(0)
  ivtRatePercent       Float          @default(0.0)
  flightStart          DateTime?
  flightEnd            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creativeAssets       CreativeAsset[]
  userTasks            UserTask[]
  moderationRecords    ModerationRecord[]

  @@index([organizationId])
  @@index([status])
  @@index([actionType])
}

model CreativeAsset {
  id             String       @id @default(cuid())
  campaignId     String
  assetUrl       String       @db.Text
  assetType      String       @default("IMAGE")
  checksum       String?
  fileSizeBytes  Int          @default(0)
  status         String       @default("APPROVED")
  reviewerNotes  String?      @db.Text
  createdAt      DateTime     @default(now())

  campaign       Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model UserTask {
  id              String       @id @default(cuid())
  campaignId      String
  userId          String
  sessionToken    String       @unique
  status          TaskStatus   @default(STARTED)
  startedAt       DateTime     @default(now())
  submittedAt     DateTime?
  validatedAt     DateTime?
  rewardPaise     BigInt       @default(0)
  telemetryDigest String?      @db.Text
  anomalyScore    Float        @default(0.0)
  fraudVerdict    FraudVerdict @default(CLEARED)
  createdAt       DateTime     @default(now())

  campaign        Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  disputes        Dispute[]
  fraudIncidents  FraudIncident[]

  @@index([campaignId])
  @@index([userId])
  @@index([sessionToken])
  @@index([status])
}

model PayoutRequest {
  id                 String       @id @default(cuid())
  userId             String
  amountPaise        BigInt
  method             String       @default("UPI")
  destinationAddress String
  maskedAddress      String
  status             PayoutStatus @default(REQUESTED)
  utrNumber          String?
  failureReason      String?
  idempotencyKey     String       @unique
  approvedByUserId   String?
  createdAt          DateTime     @default(now())
  clearedAt          DateTime?

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  disputes           Dispute[]

  @@index([userId])
  @@index([status])
  @@index([idempotencyKey])
}

model Dispute {
  id               String        @id @default(cuid())
  userId           String
  userTaskId       String?
  payoutRequestId  String?
  subject          String
  description      String        @db.Text
  evidenceUrlsJson String?       @db.Text
  status           DisputeStatus @default(OPEN)
  resolutionNotes  String?       @db.Text
  createdAt        DateTime      @default(now())
  resolvedAt       DateTime?

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userTask         UserTask?     @relation(fields: [userTaskId], references: [id], onDelete: SetNull)
  payoutRequest    PayoutRequest? @relation(fields: [payoutRequestId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model ModerationRecord {
  id             String       @id @default(cuid())
  campaignId     String
  reviewerUserId String?
  decision       String       @default("PENDING")
  reviewerNotes  String?      @db.Text
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())

  campaign       Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model FraudIncident {
  id                   String       @id @default(cuid())
  userTaskId           String?
  userId               String?
  incidentType         String
  severity             String       @default("MEDIUM")
  description          String       @db.Text
  telemetryPayloadJson String?      @db.Text
  status               String       @default("INVESTIGATING")
  resolvedByUserId     String?
  createdAt            DateTime     @default(now())

  userTask             UserTask?    @relation(fields: [userTaskId], references: [id], onDelete: SetNull)

  @@index([userTaskId])
  @@index([status])
}

model AuditLog {
  id                String       @id @default(cuid())
  actorId           String?
  actorRole         String       @default("SYSTEM")
  action            String
  entityType        String
  entityId          String
  oldStateJson      String?      @db.Text
  newStateJson      String?      @db.Text
  ipAddress         String?
  userAgent         String?
  cryptographicHash String
  createdAt         DateTime     @default(now())

  actor             User?        @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entityType])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}
