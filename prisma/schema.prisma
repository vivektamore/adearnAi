generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADVERTISER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum KycTier {
  TIER_0
  TIER_1
  TIER_2
}

enum CampaignStatus {
  DRAFT
  IN_REVIEW
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
}

enum PricingModel {
  CPO
  CPM
  HYBRID
}

enum ImpressionStatus {
  RECORDED
  VALIDATED
  REJECTED
  FLAGGED
}

enum ActionType {
  SURVEY
  SANDBOX_TRIAL
  APP_INSTALL
  VIDEO_ATTENTION
  SENTIMENT_POLL
}

enum TaskStatus {
  STARTED
  SUBMITTED
  VALIDATED
  REJECTED
  EXPIRED
}

enum FraudVerdict {
  CLEARED
  FLAGGED
  BLOCKED
}

enum LedgerTransactionType {
  CREDIT_REWARD
  DEBIT_WITHDRAWAL
  ESCROW_LOCK
  ESCROW_RELEASE
  ADVERTISER_TOPUP
  ADMIN_ADJUSTMENT
  PAYOUT_REVERSAL
  CREDIT_IMPRESSION_REWARD
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  CLEARED
  FAILED
  CANCELLED
  RECONCILIATION_PENDING
}

enum PayoutMethodType {
  UPI
  BANK_ACCOUNT
}

enum PayoutMethodStatus {
  NOT_CONFIGURED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  REMOVED
}

enum FundingOrderStatus {
  INITIATED
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_CREDITED
  REJECTED
}

enum InstallationStatus {
  ACTIVE
  INACTIVE
  REVOKED
  UNINSTALLED
}

enum PlacementStatus {
  ACTIVE
  PAUSED
  DEPRECATED
}

enum AdDecisionStatus {
  ISSUED
  CLAIMED
  EXPIRED
  DISCARDED
}

enum AdEventType {
  IMPRESSION
  CLICK
  CONVERSION
}

enum EventStatus {
  RECEIVED
  VALIDATED
  DUPLICATE
  REJECTED
  SETTLED
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
  IGNORED
}

enum AdvertisingChannel {
  ADEARN_EXTENSION
  OPENAI_CHATGPT
}

enum OpenaiObjective {
  IMPRESSIONS
  CLICKS
  CONVERSIONS
}

enum OpenaiBudgetType {
  DAILY
  LIFETIME
}

enum OpenaiResourceStatus {
  PAUSED
  ACTIVE
  ARCHIVED
}

enum OpenaiAccountStatus {
  UNLINKED
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  passwordHash       String
  name               String
  role               Role         @default(USER)
  status             UserStatus   @default(ACTIVE)
  kycTier            KycTier      @default(TIER_1)
  kycStatus          String       @default("VERIFIED")
  upiId              String?
  bankAccountNumber  String?
  bankIfsc           String?
  bankAccountName    String?
  avatarUrl          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  wallet                 Wallet?
  userOrganizations      UserOrganization[]
  userTasks              UserTask[]
  payoutRequests         PayoutRequest[]
  payoutMethods          PayoutMethod[]
  disputes               Dispute[]
  auditLogs              AuditLog[]   @relation("ActorAuditLogs")
  impressions            CampaignImpression[]
  sessions               Session[]
  userPreference         UserPreference?
  consentHistory         ConsentHistory[]
  extensionInstallations ExtensionInstallation[]
  adPreferences          UserAdPreference[]
  adRequests             AdRequest[]
  adEvents               AdEvent[]

  @@index([email])
  @@index([role])
}

model Organization {
  id                 String       @id @default(cuid())
  name               String
  gstin              String?
  pan                String?
  contactEmail       String
  isVerified         Boolean      @default(true)
  openaiAccountId    String?
  openaiAccountStatus OpenaiAccountStatus @default(UNLINKED)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  users              UserOrganization[]
  wallet             Wallet?
  campaigns          Campaign[]
  fundingOrders      FundingOrder[]
  openaiCampaigns    OpenaiCampaign[]
  openaiConversionConfig OpenaiConversionConfig?

  @@index([name])
  @@index([openaiAccountId])
}

model UserOrganization {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String       @default("OWNER")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Wallet {
  id                  String       @id @default(cuid())
  userId              String?      @unique
  organizationId      String?      @unique
  availablePaise      BigInt       @default(0)
  pendingPaise        BigInt       @default(0)
  escrowPaise         BigInt       @default(0)
  lifetimeEarnedPaise BigInt       @default(0)
  lifetimePaidPaise   BigInt       @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user                User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization        Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions        LedgerTransaction[]

  @@index([userId])
  @@index([organizationId])
}

model LedgerTransaction {
  id                 String                 @id @default(cuid())
  referenceId        String
  walletId           String
  type               LedgerTransactionType
  amountPaise        BigInt
  balanceAfterPaise  BigInt
  idempotencyKey     String                 @unique
  reason             String
  metadata           String?                @db.Text
  createdAt          DateTime               @default(now())

  wallet             Wallet                 @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([referenceId])
  @@index([idempotencyKey])
}

model Campaign {
  id                           String         @id @default(cuid())
  organizationId               String
  title                        String
  description                  String         @db.Text
  category                     String         @default("FinTech")
  actionType                   ActionType     @default(SURVEY)
  status                       CampaignStatus @default(DRAFT)
  targetUrl                    String         @db.Text
  requirementsJson             String?        @db.Text
  budgetAllocatedPaise         BigInt         @default(0)
  budgetSpentPaise             BigInt         @default(0)
  costPerOutcomePaise          BigInt         @default(0)
  pricingModel                 PricingModel   @default(CPO)
  cpmRatePaise                 BigInt         @default(0)
  creatorImpressionRewardPaise BigInt         @default(0)
  dailyBudgetCapPaise          BigInt         @default(0)
  minKycTier                   KycTier        @default(TIER_0)
  channel                      AdvertisingChannel @default(ADEARN_EXTENSION)
  targetOutcomes               Int            @default(100)
  verifiedOutcomes             Int            @default(0)
  impressionsCount             Int            @default(0)
  ivtRatePercent               Float          @default(0.0)
  flightStart                  DateTime?
  flightEnd                    DateTime?
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt

  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creativeAssets       CreativeAsset[]
  userTasks            UserTask[]
  moderationRecords    ModerationRecord[]
  impressions          CampaignImpression[]
  campaignPlacements   CampaignPlacement[]
  openaiCampaign       OpenaiCampaign?
  adDecisions          AdDecision[]
  adEvents             AdEvent[]
  dailyAggregates      CampaignDailyAggregate[]

  @@index([organizationId])
  @@index([status])
  @@index([actionType])
  @@index([pricingModel])
}

model CreativeAsset {
  id             String       @id @default(cuid())
  campaignId     String
  assetUrl       String       @db.Text
  assetType      String       @default("IMAGE")
  checksum       String?
  fileSizeBytes  Int          @default(0)
  status         String       @default("APPROVED")
  reviewerNotes  String?      @db.Text
  createdAt      DateTime     @default(now())

  campaign       Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  impressions    CampaignImpression[]

  @@index([campaignId])
}

model CampaignImpression {
  id               String            @id @default(cuid())
  campaignId       String
  userId           String
  creativeAssetId  String?
  eventId          String            @unique
  sessionToken     String            @db.Text
  tokenDigest      String            @unique @db.VarChar(64)
  dwellSeconds     Float             @default(0.0)
  viewabilityScore Float             @default(1.0)
  status           ImpressionStatus  @default(VALIDATED)
  rewardPaise      BigInt            @default(0)
  chargePaise      BigInt            @default(0)
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime          @default(now())
  validatedAt      DateTime?

  campaign         Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  creativeAsset    CreativeAsset?    @relation(fields: [creativeAssetId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@index([createdAt])
}

model UserTask {
  id              String       @id @default(cuid())
  campaignId      String
  userId          String
  sessionToken    String       @unique
  status          TaskStatus   @default(STARTED)
  startedAt       DateTime     @default(now())
  submittedAt     DateTime?
  validatedAt     DateTime?
  rewardPaise     BigInt       @default(0)
  telemetryDigest String?      @db.Text
  anomalyScore    Float        @default(0.0)
  fraudVerdict    FraudVerdict @default(CLEARED)
  createdAt       DateTime     @default(now())

  campaign        Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  disputes        Dispute[]
  fraudIncidents  FraudIncident[]

  @@index([campaignId])
  @@index([userId])
  @@index([sessionToken])
  @@index([status])
}

model PayoutRequest {
  id                 String        @id @default(cuid())
  userId             String
  payoutMethodId     String?
  amountPaise        BigInt
  method             String        @default("UPI")
  destinationAddress String
  maskedAddress      String
  status             PayoutStatus  @default(REQUESTED)
  utrNumber          String?
  failureReason      String?
  idempotencyKey     String        @unique
  approvedByUserId   String?
  outboxStatus       String?       @default("DISPATCHED")
  dispatchAttempts   Int           @default(1)
  lastDispatchedAt   DateTime?
  createdAt          DateTime      @default(now())
  clearedAt          DateTime?

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payoutMethod       PayoutMethod? @relation(fields: [payoutMethodId], references: [id], onDelete: SetNull)
  disputes           Dispute[]

  @@index([userId])
  @@index([payoutMethodId])
  @@index([status])
  @@index([idempotencyKey])
}

model Dispute {
  id               String        @id @default(cuid())
  userId           String
  userTaskId       String?
  payoutRequestId  String?
  subject          String
  description      String        @db.Text
  evidenceUrlsJson String?       @db.Text
  status           DisputeStatus @default(OPEN)
  resolutionNotes  String?       @db.Text
  createdAt        DateTime      @default(now())
  resolvedAt       DateTime?

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userTask         UserTask?     @relation(fields: [userTaskId], references: [id], onDelete: SetNull)
  payoutRequest    PayoutRequest? @relation(fields: [payoutRequestId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model ModerationRecord {
  id             String       @id @default(cuid())
  campaignId     String
  reviewerUserId String?
  decision       String       @default("PENDING")
  reviewerNotes  String?      @db.Text
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())

  campaign       Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model FraudIncident {
  id                   String       @id @default(cuid())
  userTaskId           String?
  userId               String?
  incidentType         String
  severity             String       @default("MEDIUM")
  description          String       @db.Text
  telemetryPayloadJson String?      @db.Text
  status               String       @default("INVESTIGATING")
  resolvedByUserId     String?
  createdAt            DateTime     @default(now())

  userTask             UserTask?    @relation(fields: [userTaskId], references: [id], onDelete: SetNull)

  @@index([userTaskId])
  @@index([status])
}

model AuditLog {
  id                String       @id @default(cuid())
  actorId           String?
  actorRole         String       @default("SYSTEM")
  action            String
  entityType        String
  entityId          String
  oldStateJson      String?      @db.Text
  newStateJson      String?      @db.Text
  ipAddress         String?
  userAgent         String?
  cryptographicHash String
  createdAt         DateTime     @default(now())

  actor             User?        @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entityType])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model PayoutMethod {
  id                 String             @id @default(cuid())
  userId             String
  type               PayoutMethodType   @default(UPI)
  accountHolderName  String
  destinationAddress String
  maskedAddress      String
  ifscCode           String?
  bankName           String?
  status             PayoutMethodStatus @default(VERIFIED)
  isDefault          Boolean            @default(false)
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payoutRequests     PayoutRequest[]

  @@index([userId])
  @@index([status])
}

model FundingOrder {
  id                String             @id @default(cuid())
  organizationId    String
  amountPaise       BigInt
  gstPaise          BigInt             @default(0)
  totalPaise        BigInt
  currency          String             @default("INR")
  status            FundingOrderStatus @default(INITIATED)
  provider          String             @default("SANDBOX_NODAL")
  providerOrderId   String?            @unique
  providerPaymentId String?
  utrNumber         String?
  idempotencyKey    String             @unique
  metadataJson      String?            @db.Text
  confirmedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum EntryType {
  DEBIT
  CREDIT
}

model Account {
  id             String         @id @default(cuid())
  code           String         @unique
  name           String
  type           AccountType
  currency       String         @default("INR")
  userId         String?
  organizationId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  journalEntries JournalEntry[]

  @@index([code])
  @@index([type])
  @@index([userId])
  @@index([organizationId])
}

model JournalTransaction {
  id             String                 @id @default(cuid())
  referenceId    String
  idempotencyKey String                 @unique
  type           LedgerTransactionType
  description    String
  actorId        String?
  metadataJson   String?                @db.Text
  postedAt       DateTime               @default(now())

  entries        JournalEntry[]

  @@index([referenceId])
  @@index([idempotencyKey])
  @@index([postedAt])
}

model JournalEntry {
  id                   String             @id @default(cuid())
  journalTransactionId String
  accountId            String
  entryType            EntryType
  amountPaise          BigInt
  currency             String             @default("INR")
  createdAt            DateTime           @default(now())

  journalTransaction   JournalTransaction @relation(fields: [journalTransactionId], references: [id], onDelete: Cascade)
  account              Account            @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalTransactionId])
  @@index([accountId])
  @@index([entryType])
}

// =========================================================================
// HYBRID AD NETWORK EXTENSION MODELS (PHASE 1 ADDITIVE FOUNDATION)
// =========================================================================

model Session {
  id           String    @id @default(cuid())
  userId       String
  sessionToken String    @unique @db.VarChar(128)
  ipAddress    String?
  userAgent    String?   @db.Text
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@index([expiresAt])
}

model UserPreference {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  optInRewards            Boolean  @default(true)
  emailNotifications      Boolean  @default(true)
  preferredCategoriesJson String?  @db.Text
  theme                   String   @default("SYSTEM")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ConsentHistory {
  id                 String   @id @default(cuid())
  userId             String
  consentType        String
  granted            Boolean  @default(true)
  ipAddress          String?
  userAgent          String?  @db.Text
  consentTextVersion String   @default("1.0")
  consentedAt        DateTime @default(now())

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([consentType])
}

model ExtensionInstallation {
  id               String             @id @default(cuid())
  userId           String
  installationId   String             @unique @db.VarChar(64)
  extensionVersion String             @default("2.0.0")
  clientPlatform   String?
  status           InstallationStatus @default(ACTIVE)
  lastSeenAt       DateTime           @default(now())
  installedAt      DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([installationId])
  @@index([status])
}

model UserAdPreference {
  id        String   @id @default(cuid())
  userId    String
  category  String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
}

model AdPlacement {
  id              String          @id @default(cuid())
  key             String          @unique @db.VarChar(64)
  name            String
  surfaceType     String
  dimensions      String
  floorCpmPaise   BigInt          @default(3000)
  floorCpcPaise   BigInt          @default(150)
  minDwellSeconds Float           @default(1.0)
  status          PlacementStatus @default(ACTIVE)
  policyText      String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  campaignPlacements CampaignPlacement[]
  adRequests         AdRequest[]
  dailyAggregates    PlacementDailyAggregate[]

  @@index([key])
  @@index([status])
}

model CampaignPlacement {
  id          String      @id @default(cuid())
  campaignId  String
  placementId String
  status      String      @default("ACTIVE")
  createdAt   DateTime    @default(now())

  campaign    Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  placement   AdPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@unique([campaignId, placementId])
  @@index([campaignId])
  @@index([placementId])
}

model AdRequest {
  id            String       @id @default(cuid())
  requestId     String       @unique @db.VarChar(64)
  userId        String?
  placementId   String?
  ipAddress     String?
  userAgent     String?      @db.Text
  eligibleCount Int          @default(0)
  createdAt     DateTime     @default(now())

  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  placement     AdPlacement? @relation(fields: [placementId], references: [id], onDelete: SetNull)
  decisions     AdDecision[]

  @@index([requestId])
  @@index([userId])
  @@index([placementId])
  @@index([createdAt])
}

model AdDecision {
  id              String           @id @default(cuid())
  adRequestId     String?
  campaignId      String
  creativeAssetId String?
  userId          String?
  tokenDigest     String           @unique @db.VarChar(64)
  decisionToken   String           @db.Text
  pricingModel    PricingModel     @default(CPM)
  chargePaise     BigInt           @default(0)
  rewardPaise     BigInt           @default(0)
  status          AdDecisionStatus @default(ISSUED)
  expiresAt       DateTime
  createdAt       DateTime         @default(now())

  adRequest       AdRequest?       @relation(fields: [adRequestId], references: [id], onDelete: SetNull)
  campaign        Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  events          AdEvent[]

  @@index([adRequestId])
  @@index([campaignId])
  @@index([tokenDigest])
  @@index([status])
  @@index([expiresAt])
}

model AdEvent {
  id           String      @id @default(cuid())
  eventId      String      @unique @db.VarChar(64)
  adDecisionId String?
  campaignId   String
  userId       String
  eventType    AdEventType
  tokenDigest  String      @unique @db.VarChar(64)
  status       EventStatus @default(RECEIVED)
  payloadJson  String?     @db.Text
  chargePaise  BigInt      @default(0)
  rewardPaise  BigInt      @default(0)
  ipAddress    String?
  userAgent    String?     @db.Text
  receivedAt   DateTime    @default(now())
  processedAt  DateTime?

  adDecision   AdDecision? @relation(fields: [adDecisionId], references: [id], onDelete: SetNull)
  campaign     Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([campaignId])
  @@index([userId])
  @@index([eventType])
  @@index([tokenDigest])
  @@index([status])
  @@index([receivedAt])
}

model FraudCase {
  id                    String    @id @default(cuid())
  caseNumber            String    @unique @db.VarChar(32)
  incidentType          String
  severity              String    @default("MEDIUM")
  targetType            String
  targetId              String
  userId                String?
  campaignId            String?
  status                String    @default("OPEN")
  description           String    @db.Text
  telemetryEvidenceJson String?   @db.Text
  resolutionNotes       String?   @db.Text
  resolvedByUserId      String?
  resolvedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([caseNumber])
  @@index([userId])
  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
}

model PaymentWebhookRecord {
  id             String        @id @default(cuid())
  provider       String
  eventType      String
  eventId        String?
  idempotencyKey String        @unique @db.VarChar(128)
  payloadJson    String        @db.Text
  status         WebhookStatus @default(PENDING)
  errorReason    String?       @db.Text
  receivedAt     DateTime      @default(now())
  processedAt    DateTime?

  @@index([provider])
  @@index([idempotencyKey])
  @@index([status])
  @@index([receivedAt])
}

model CampaignDailyAggregate {
  id                 String   @id @default(cuid())
  campaignId         String
  date               DateTime @db.Date
  impressionsCount   Int      @default(0)
  clicksCount        Int      @default(0)
  conversionsCount   Int      @default(0)
  spendPaise         BigInt   @default(0)
  creatorRewardPaise BigInt   @default(0)
  ivtBlockedCount    Int      @default(0)
  updatedAt          DateTime @updatedAt

  campaign           Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([campaignId])
  @@index([date])
}

model PlacementDailyAggregate {
  id               String      @id @default(cuid())
  placementId      String
  date             DateTime    @db.Date
  requestsCount    Int         @default(0)
  impressionsCount Int         @default(0)
  clicksCount      Int         @default(0)
  revenuePaise     BigInt      @default(0)
  updatedAt        DateTime    @updatedAt

  placement        AdPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@unique([placementId, date])
  @@index([placementId])
  @@index([date])
}

model OpenaiCampaign {
  id                   String               @id @default(cuid())
  organizationId       String
  campaignId           String?              @unique
  externalCampaignId   String?              @unique @db.VarChar(64)
  name                 String
  objective            OpenaiObjective      @default(CLICKS)
  status               OpenaiResourceStatus @default(PAUSED)
  budgetType           OpenaiBudgetType     @default(DAILY)
  budgetMicros         BigInt               @default(0) // Integer micros in OpenAI account currency ($1 = 1,000,000 micros)
  reportedSpendMicros  BigInt               @default(0)
  currency             String               @default("USD")
  startDate            DateTime?
  endDate              DateTime?
  geoTargetingJson     String?              @db.Text
  platformsJson        String?              @db.Text
  landingPageUrl       String               @db.Text
  complianceJson       String?              @db.Text
  lastSyncedAt         DateTime?
  syncError            String?              @db.Text
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adearnCampaign       Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  adGroups             OpenaiAdGroup[]
  insightReports       OpenaiInsightReport[]

  @@index([organizationId])
  @@index([externalCampaignId])
  @@index([status])
}

model OpenaiAdGroup {
  id                   String               @id @default(cuid())
  openaiCampaignId     String
  externalAdGroupId    String?              @unique @db.VarChar(64)
  name                 String
  status               OpenaiResourceStatus @default(PAUSED)
  contextHintsJson     String?              @db.Text
  bidStrategy          String               @default("MAX_CLICKS")
  maxBidMicros         BigInt?
  billingEvent         String               @default("click") // impression | click
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  openaiCampaign       OpenaiCampaign       @relation(fields: [openaiCampaignId], references: [id], onDelete: Cascade)
  ads                  OpenaiAd[]

  @@index([openaiCampaignId])
  @@index([externalAdGroupId])
}

model OpenaiAd {
  id                   String               @id @default(cuid())
  adGroupId            String
  externalAdId         String?              @unique @db.VarChar(64)
  name                 String
  brandName            String
  faviconUrl           String?              @db.Text
  headline             String
  description          String               @db.Text
  imageUrl             String               @db.Text
  landingPageUrl       String               @db.Text
  utmParameters        String?              @db.Text
  status               OpenaiResourceStatus @default(PAUSED)
  reviewStatus         String               @default("PENDING_REVIEW")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  adGroup              OpenaiAdGroup        @relation(fields: [adGroupId], references: [id], onDelete: Cascade)

  @@index([adGroupId])
  @@index([externalAdId])
}

model OpenaiInsightReport {
  id                    String         @id @default(cuid())
  openaiCampaignId      String
  dataDate              DateTime       @db.Date
  impressions           Int            @default(0)
  clicks                Int            @default(0)
  spendMicros           BigInt         @default(0)
  ctrPercent            Float          @default(0.0)
  avgCpcMicros          BigInt         @default(0)
  avgCpmMicros          BigInt         @default(0)
  conversions           Int            @default(0)
  cpaMicros             BigInt         @default(0)
  attributedSalesMicros BigInt         @default(0)
  roas                  Float          @default(0.0)
  freshnessTimestamp    DateTime       @default(now())
  createdAt             DateTime       @default(now())

  openaiCampaign        OpenaiCampaign @relation(fields: [openaiCampaignId], references: [id], onDelete: Cascade)

  @@unique([openaiCampaignId, dataDate])
  @@index([openaiCampaignId])
  @@index([dataDate])
}

model OpenaiConversionConfig {
  id                         String       @id @default(cuid())
  organizationId             String       @unique
  pixelId                    String?
  pixelCode                  String?      @db.Text
  conversionsApiEnabled      Boolean      @default(false)
  attributionWindowDays      Int          @default(7)
  eventDeduplicationEnabled  Boolean      @default(true)
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

